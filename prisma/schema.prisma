// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Better Auth required models
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // The advertiser the user currently has selected in the console. The BE
  // (be/src/auth.rs, be/src/helpers/advertiser.rs) resolves "which account is
  // this request acting as?" through this pointer. Today the Advertiser→User
  // relation is still 1:1, so this just mirrors `advertiser.id`, but the
  // column exists so we're forward-compatible with the BE's many-accounts
  // model without another migration.
  activeAdvertiserId String?     @unique
  activeAdvertiser   Advertiser? @relation("UserActiveAdvertiser", fields: [activeAdvertiserId], references: [id], onDelete: SetNull)

  sessions   Session[]
  accounts   Account[]
  advertiser Advertiser?
  publisher  Publisher?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ===================== Vara Ads DSP =====================

model Advertiser {
  id                   String     @id @default(cuid())
  userId               String     @unique
  projectName          String
  websiteUrl           String?
  contactEmail         String?
  telegramHandle       String?
  discordHandle        String?
  businessType         String?
  primaryWalletAddress String?
  supportedChains      Chain[]    @default([])
  contractAddrs        String[]
  tokenContracts       String[]   @default([])
  nftContracts         String[]   @default([])
  treasuryWallets      String[]   @default([])
  campaignWallets      String[]   @default([])
  chain                Chain      @default(POLYGON)
  onboardedAt          DateTime?
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUser        User?      @relation("UserActiveAdvertiser")
  campaigns            Campaign[]
  wallet               Wallet?
  assets               Asset[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@map("advertiser")
}

model Wallet {
  id                          String               @id @default(cuid())
  advertiserId                String               @unique
  balanceUsdcCents            Int                  @default(0)
  pendingUsdcCents            Int                  @default(0)
  reservedUsdcCents           Int                  @default(0)
  totalDepositedUsdcCents     Int                  @default(0)
  totalSpentUsdcCents         Int                  @default(0)
  // Permit2 / auto-recharge settings
  autoRechargeEnabled         Boolean              @default(false)
  rechargeThresholdCents      Int                  @default(1000)
  preferredRechargeAmountCents Int                 @default(2500)
  advertiser                  Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deposits                    Deposit[]
  transactions                WalletTransaction[]
  permit2Auth                 Permit2Authorization?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@map("wallet")
}

model Permit2Authorization {
  id               String            @id @default(cuid())
  walletId         String            @unique
  userWallet       String
  tokenAddress     String
  spenderAddress   String
  authorizedAmount BigInt
  expiresAt        DateTime
  nonce            Int
  sigDeadline      DateTime
  signature        String
  status           Permit2AuthStatus @default(ACTIVE)
  amountPulled     BigInt            @default(0)
  lastPullAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  chainId          Int               @default(137)
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("permit2_authorization")
}

enum Permit2AuthStatus {
  ACTIVE
  EXPIRED
  REVOKED
  CEILING_REACHED
}

model Deposit {
  id              String         @id @default(cuid())
  walletId        String
  chain           Chain          @default(ETHEREUM)
  network         DepositNetwork @default(SEPOLIA)
  txHash          String         @unique
  fromAddress     String
  toAddress       String
  amountUsdcCents Int
  status          DepositStatus  @default(CONFIRMED)
  blockNumber     Int?
  confirmedAt     DateTime?
  wallet          Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([walletId])
  @@map("deposit")
}

model WalletTransaction {
  id              String         @id @default(cuid())
  walletId        String
  type            WalletTxType
  status          WalletTxStatus @default(COMPLETED)
  amountUsdcCents Int
  description     String
  source          String
  txHash          String?
  depositId       String?
  occurredAt      DateTime       @default(now())
  wallet          Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, occurredAt])
  @@map("wallet_transaction")
}

enum DepositNetwork {
  MAINNET
  SEPOLIA
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum WalletTxType {
  DEPOSIT
  AD_SPEND
  REFUND
  WITHDRAWAL
  PERMIT2_RECHARGE
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
}

// ===================== Vara Ads SSP =====================

model Publisher {
  id          String            @id @default(cuid())
  userId      String            @unique
  siteName    String
  primaryUrl  String?
  category    InventoryCategory @default(OTHER)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placements  Placement[]
  wallet      PublisherWallet?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("publisher")
}

model Placement {
  id                  String             @id @default(cuid())
  publisherId         String
  name                String
  format              AdFormat
  chains              Chain[]
  status              PlacementStatus    @default(LIVE)
  width               Int?
  height              Int?
  floorPriceUsdcCents Int                @default(0)
  // First time the RTB engine saw a bid request for this placement. Stamped
  // once by the auction handler and used by the SSP onboarding wizard to
  // confirm the publisher has dropped in the SDK.
  firstSeenAt         DateTime?
  publisher           Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  earnings            PublisherEarning[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([publisherId])
  @@map("placement")
}

model PublisherWallet {
  id                      String               @id @default(cuid())
  publisherId             String               @unique
  payoutAddress           String?
  payoutChain             Chain                @default(BASE)
  payoutNetwork           DepositNetwork       @default(SEPOLIA)
  revShareBps             Int                  @default(7000)
  availableUsdcCents      Int                  @default(0)
  pendingUsdcCents        Int                  @default(0)
  lifetimeEarnedUsdcCents Int                  @default(0)
  lifetimePaidUsdcCents   Int                  @default(0)
  publisher               Publisher            @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  earnings                PublisherEarning[]
  payouts                 Payout[]
  statements              PublisherStatement[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@map("publisher_wallet")
}

model PublisherEarning {
  id                String              @id @default(cuid())
  publisherWalletId String
  placementId       String?
  statementId       String?
  date              DateTime            @db.Date
  impressions       Int                 @default(0)
  clicks            Int                 @default(0)
  grossUsdcCents    Int                 @default(0)
  feeUsdcCents      Int                 @default(0)
  netUsdcCents      Int                 @default(0)
  status            EarningStatus       @default(PENDING)
  publisherWallet   PublisherWallet     @relation(fields: [publisherWalletId], references: [id], onDelete: Cascade)
  placement         Placement?          @relation(fields: [placementId], references: [id], onDelete: SetNull)
  statement         PublisherStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())

  @@index([publisherWalletId, date])
  @@index([statementId])
  @@map("publisher_earning")
}

model PublisherStatement {
  id                String             @id @default(cuid())
  publisherWalletId String
  periodStart       DateTime           @db.Date
  periodEnd         DateTime           @db.Date
  impressions       Int                @default(0)
  clicks            Int                @default(0)
  grossUsdcCents    Int                @default(0)
  feeUsdcCents      Int                @default(0)
  netUsdcCents      Int                @default(0)
  status            StatementStatus    @default(OPEN)
  publisherWallet   PublisherWallet    @relation(fields: [publisherWalletId], references: [id], onDelete: Cascade)
  earnings          PublisherEarning[]
  payouts           Payout[]
  createdAt         DateTime           @default(now())
  finalizedAt       DateTime?

  @@index([publisherWalletId, periodStart])
  @@map("publisher_statement")
}

model Payout {
  id                String              @id @default(cuid())
  publisherWalletId String
  statementId       String?
  chain             Chain
  network           DepositNetwork      @default(SEPOLIA)
  amountUsdcCents   Int
  feeUsdcCents      Int                 @default(0)
  toAddress         String
  txHash            String?             @unique
  status            PayoutStatus        @default(PENDING)
  failureReason     String?
  initiatedAt       DateTime            @default(now())
  settledAt         DateTime?
  publisherWallet   PublisherWallet     @relation(fields: [publisherWalletId], references: [id], onDelete: Cascade)
  statement         PublisherStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([publisherWalletId, initiatedAt])
  @@map("payout")
}

enum EarningStatus {
  PENDING
  CLEARED
  PAID
  REVERSED
}

enum StatementStatus {
  OPEN
  FINALIZED
  PAID
}

enum PayoutStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum PlacementStatus {
  DRAFT
  LIVE
  PAUSED
}

enum AdFormat {
  BANNER
  NATIVE
  INTERSTITIAL
  WALLET_CONTEXTUAL
  VIDEO
}

enum InventoryCategory {
  DEFI
  NFT
  GAMING
  NEWS
  SOCIAL
  TOOLS
  OTHER
}

model Campaign {
  id                    String         @id @default(cuid())
  advertiserId          String
  name                  String
  description           String?
  vertical              Vertical
  status                CampaignStatus @default(DRAFT)
  objective             Objective
  pricingModel          PricingModel   @default(CPM)
  bidStrategy           BidStrategy    @default(MANUAL)
  pacing                Pacing         @default(STANDARD)
  budgetUsdCents        Int
  // Escrow tracking owned by be/src/helpers/wallet_escrow.rs:
  //   reservedUsdcCents = funds locked against this campaign right now
  //                       (invariant: equals max(0, budget - spent) while ACTIVE)
  //   spentUsdcCents    = cumulative spend recorded against this campaign
  // BE writes both via INSERT/UPDATE; FE only ever reads them.
  reservedUsdcCents     Int            @default(0)
  spentUsdcCents        Int            @default(0)
  dailyCapUsdCents      Int?
  bidUsdCents           Int
  frequencyCapPerWallet Int?
  frequencyCapHours     Int?
  startDate             DateTime
  endDate               DateTime?
  conversionContract    String?
  conversionEvent       String?
  conversionWindowDays  Int?
  brandSafetyKeywords   String[]
  advertiser            Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  creatives             Creative[]
  targeting             Targeting?
  adGroups              AdGroup[]
  metrics               MetricDaily[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([advertiserId, status])
  @@map("campaign")
}

model AdGroup {
  id               String         @id @default(cuid())
  campaignId       String
  name             String
  status           CampaignStatus @default(DRAFT)
  bidUsdCents      Int
  pricingModel     PricingModel   @default(CPM)
  bidStrategy      BidStrategy    @default(MANUAL)
  dailyCapUsdCents Int?
  startDate        DateTime?
  endDate          DateTime?
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targeting        AdGroupTargeting?
  ads              Ad[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([campaignId])
  @@map("ad_group")
}

model AdGroupTargeting {
  id                   String       @id @default(cuid())
  adGroupId            String       @unique
  chains               Chain[]
  geos                 String[]
  deviceTypes          DeviceType[]
  segmentIds           String[]
  holdsAnyContract     String[]
  excludesContracts    String[]
  adGroup              AdGroup      @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  @@map("ad_group_targeting")
}

model Creative {
  id               String         @id @default(cuid())
  campaignId       String
  name             String
  format           CreativeFormat
  width            Int
  height           Int
  assetUrl         String
  clickUrl         String
  walletConnectCta Boolean        @default(false)
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([campaignId])
  @@map("creative")
}

// ===================== Multi-format Ads (Google-Ads-style) =====================
//
// `Asset` is the reusable media/text primitive (image, video, headline, etc.)
// scoped to an advertiser. `Ad` is a composition of assets attached to an
// AdGroup with a specific `AdType`. `AdAssetLink` is the pivot that names the
// role each asset plays in the ad (PRIMARY_IMAGE, HEADLINE_1, etc.). The
// legacy `Creative` model is kept alongside for backward compatibility while
// we migrate; the RTB engine prefers `Ad` rows when present.

model Asset {
  id              String         @id @default(cuid())
  advertiserId    String
  type            AssetType
  status          AssetStatus    @default(PENDING_REVIEW)
  // Polymorphic payload: exactly one of textValue / fileUrl is non-null per
  // asset, depending on `type`. Headlines/descriptions/CTAs/clickUrls use
  // textValue; images/videos/logos/html-bundles use fileUrl.
  textValue       String?
  fileUrl         String?
  fileMimeType    String?
  fileBytes       Int?
  width           Int?
  height          Int?
  durationMs      Int?
  aspectRatio     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  // Web3-specific: if non-null, the asset is shown only to wallets holding
  // this contract (and optionally at least `gatedByMinHold` tokens of it).
  gatedByContract String?
  gatedByMinHold  Decimal?
  advertiser      Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  links           AdAssetLink[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([advertiserId, type, status])
  @@map("asset")
}

model Ad {
  id              String         @id @default(cuid())
  adGroupId       String
  name            String
  type            AdType
  status          AdStatus       @default(DRAFT)
  trafficShare    Int            @default(100)
  clickUrl        String
  finalUrlSuffix  String?
  // Denormalized eligibility flag: refreshed on save. RESPONSIVE_DISPLAY needs
  // a minimum asset mix (≥3 images, ≥2 headlines, ≥2 descriptions, etc.) —
  // ads failing the bar can save but not serve.
  hasMinAssets    Boolean        @default(false)
  adGroup         AdGroup        @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  links           AdAssetLink[]
  metrics         AdMetricDaily[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([adGroupId, status])
  @@map("ad")
}

model AdAssetLink {
  id      String     @id @default(cuid())
  adId    String
  assetId String
  role    AssetRole
  // Pinning weight, Google-Ads-style. 0 = let optimizer pick. Higher numbers
  // bias the rotation toward this asset within its role bucket.
  weight  Int        @default(1)
  ad      Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  asset   Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([adId, assetId, role])
  @@index([adId])
  @@index([assetId])
  @@map("ad_asset_link")
}

model AdMetricDaily {
  id               String   @id @default(cuid())
  adId             String
  date             DateTime @db.Date
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  viewableImps     Int      @default(0)
  videoStarts      Int      @default(0)
  videoCompletes   Int      @default(0)
  walletConnects   Int      @default(0)
  onChainConvs     Int      @default(0)
  spendUsdcCents   Int      @default(0)
  revenueUsdcCents Int      @default(0)
  ad               Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([date])
  @@map("ad_metric_daily")
}

enum AdType {
  STATIC_DISPLAY
  RESPONSIVE_DISPLAY
  VIDEO_IN_STREAM
  VIDEO_OUTSTREAM
  VIDEO_REWARDED
  NATIVE
  APP_INSTALL
  INTERSTITIAL
  HTML5
  WALLET_CONTEXTUAL
  TOKEN_GATED
  CATALOG_NFT
}

enum AdStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  HEADLINE
  LONG_HEADLINE
  DESCRIPTION
  LOGO
  HTML_BUNDLE
  CALL_TO_ACTION
  CLICK_URL
  PRODUCT_FEED_ITEM
}

enum AssetStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// AssetRole names the slot an asset fills inside an Ad. Slots are
// format-specific — RESPONSIVE_DISPLAY uses PRIMARY_IMAGE / SQUARE_IMAGE /
// LOGO + headline/description slots; VIDEO_* uses VIDEO_FILE + COMPANION_BANNER
// and a couple of text slots; NATIVE uses headline + description + image + cta.
enum AssetRole {
  PRIMARY_IMAGE
  SQUARE_IMAGE
  PORTRAIT_IMAGE
  LOGO
  VIDEO_FILE
  COMPANION_BANNER
  HEADLINE_1
  HEADLINE_2
  HEADLINE_3
  HEADLINE_4
  HEADLINE_5
  LONG_HEADLINE
  DESCRIPTION_1
  DESCRIPTION_2
  DESCRIPTION_3
  CTA
  HTML_BUNDLE
}

model Targeting {
  id                   String       @id @default(cuid())
  campaignId           String       @unique
  chains               Chain[]
  geos                 String[]
  deviceTypes          DeviceType[]
  segmentIds           String[]
  minWalletAgeDays     Int?
  minPortfolioUsdCents Int?
  holdsAnyContract     String[]
  excludesContracts    String[]
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("targeting")
}

model WalletSegment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  chain       Chain?
  estSize     Int
  createdAt   DateTime @default(now())

  @@map("wallet_segment")
}

model MetricDaily {
  id             String   @id @default(cuid())
  campaignId     String
  date           DateTime @db.Date
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  walletConnects Int      @default(0)
  onChainConvs   Int      @default(0)
  spendUsdCents  Int      @default(0)
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("metric_daily")
}

model AttributionEvent {
  id            String        @id @default(cuid())
  campaignId    String
  walletHash    String
  eventType     AttrEventType
  txHash        String?
  chain         Chain?
  valueUsdCents Int?
  occurredAt    DateTime

  @@index([campaignId, occurredAt])
  @@index([walletHash])
  @@map("attribution_event")
}

enum Chain {
  ETHEREUM
  POLYGON
  SOLANA
  BASE
  ARBITRUM
  OPTIMISM
  BSC
  AVALANCHE
}

enum Vertical {
  TOKEN_LAUNCH
  NFT_DROP
  DEFI
  DAPP_GROWTH
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum Objective {
  AWARENESS
  WALLET_CONNECTS
  ON_CHAIN_CONVERSION
  TOKEN_HOLDERS
}

enum PricingModel {
  CPM
  CPC
  CPA
}

enum BidStrategy {
  MANUAL
  AUTO
  MAX_CONVERSIONS
  TARGET_CPA
}

enum Pacing {
  STANDARD
  ACCELERATED
  EVEN
}

enum CreativeFormat {
  BANNER
  HTML5
  VIDEO
  NATIVE
}

enum DeviceType {
  DESKTOP
  MOBILE
}

enum AttrEventType {
  IMPRESSION
  CLICK
  WALLET_CONNECT
  ON_CHAIN_CONV
}
